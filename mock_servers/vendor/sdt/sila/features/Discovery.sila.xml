<Feature xmlns="http://www.sila-standard.org" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Category="sdt" FeatureVersion="2.0" MaturityLevel="Draft" Originator="org.tainstruments" SiLA2Version="1.0" xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
<Identifier>Discovery</Identifier>
<DisplayName>SDT discovery &amp; info</DisplayName>
<Description>Health, discovery, instrument metadata.</Description>
<DataTypeDefinition>
  <Identifier>Request</Identifier>
  <DisplayName>Request</DisplayName>
  <Description>Standard command request. Version is the envelope schema version. Empty CorrelationId means none. TimeoutSeconds 0 means the server default. Empty Payload means none.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Version</Identifier>
        <DisplayName>Version</DisplayName>
        <Description>Envelope schema version. Currently 2.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>CorrelationId</Identifier>
        <DisplayName>Correlation id</DisplayName>
        <Description>Caller correlation id. Empty means none. Echoed on the response.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>TimeoutSeconds</Identifier>
        <DisplayName>Timeout (seconds)</DisplayName>
        <Description>Command timeout in seconds. 0 means the server default.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Payload</Identifier>
        <DisplayName>Payload</DisplayName>
        <Description>UTF-8 JSON string for the request body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>Envelope</Identifier>
  <DisplayName>Envelope</DisplayName>
  <Description>Standard command result. Outcome is Succeeded, Failed, Rejected, or Running. Code is 0 on Succeeded and empty on Running. Message defaults to success on Succeeded. Empty Details means none.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Version</Identifier>
        <DisplayName>Version</DisplayName>
        <Description>Envelope schema version. Currently 2.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Outcome</Identifier>
        <DisplayName>Outcome</DisplayName>
        <Description>Succeeded, Failed, Rejected, or Running.</Description>
        <DataType>
          <Constrained>
            <DataType>
              <Basic>String</Basic>
            </DataType>
            <Constraints>
              <Set>
                <Value>Succeeded</Value>
                <Value>Failed</Value>
                <Value>Rejected</Value>
                <Value>Running</Value>
              </Set>
            </Constraints>
          </Constrained>
        </DataType>
      </Element>
      <Element>
        <Identifier>Code</Identifier>
        <DisplayName>Code</DisplayName>
        <Description>Additive lowercase dotted code on Failed/Rejected. 0 on Succeeded. Empty on Running.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Message</Identifier>
        <DisplayName>Message</DisplayName>
        <Description>Human-readable outcome message. Defaults to success on Succeeded.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>CorrelationId</Identifier>
        <DisplayName>Correlation id</DisplayName>
        <Description>Echo of the request correlation id. Empty means none.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Payload</Identifier>
        <DisplayName>Payload</DisplayName>
        <Description>UTF-8 JSON string for the result body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Details</Identifier>
        <DisplayName>Details</DisplayName>
        <Description>UTF-8 JSON string for diagnostics such as status_code, url, and canForce. Empty string means none.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>GetHealthJsonResult</Identifier>
  <DisplayName>Get health result</DisplayName>
  <Description>GetHealthJson Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>ListInstancesJsonResult</Identifier>
  <DisplayName>List instances result</DisplayName>
  <Description>ListInstancesJson Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>GetInstrumentInfoJsonResult</Identifier>
  <DisplayName>Get instrument info result</DisplayName>
  <Description>GetInstrumentInfoJson Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<Command>
  <Identifier>GetHealthJson</Identifier>
  <DisplayName>REST health</DisplayName>
  <Description>GET /health. Result.Payload is GetHealthJsonResult.</Description>
  <Observable>No</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<Command>
  <Identifier>ListInstancesJson</Identifier>
  <DisplayName>TRIOS instances</DisplayName>
  <Description>GET /instances. Result.Payload is ListInstancesJsonResult.</Description>
  <Observable>No</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<Command>
  <Identifier>GetInstrumentInfoJson</Identifier>
  <DisplayName>Instrument info</DisplayName>
  <Description>GET /info (requires Bearer when TRIOS mandates). Result.Payload is GetInstrumentInfoJsonResult.</Description>
  <Observable>No</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<DefinedExecutionError>
  <Identifier>InternalError</Identifier>
  <DisplayName>Internal error</DisplayName>
  <Description>The server could not build an envelope (connection drop, unexpected exception, or cancellation).</Description>
</DefinedExecutionError>
</Feature>
