<Feature xmlns="http://www.sila-standard.org" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Category="sdt" FeatureVersion="2.0" MaturityLevel="Draft" Originator="org.tainstruments" SiLA2Version="1.0" xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
<Identifier>InstrumentStatus</Identifier>
<DisplayName>SDT instrument status</DisplayName>
<Description>Expose instrument snapshot (subscribeable), synchronization waits, and error list. Command Payload shapes are DataTypeDefinitions encoded as JSON objects in Payload.</Description>
<DataTypeDefinition>
  <Identifier>Request</Identifier>
  <DisplayName>Request</DisplayName>
  <Description>Standard command request. Version is the envelope schema version. Empty CorrelationId means none. TimeoutSeconds 0 means the server default. Empty Payload means none.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Version</Identifier>
        <DisplayName>Version</DisplayName>
        <Description>Envelope schema version. Currently 2.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>CorrelationId</Identifier>
        <DisplayName>Correlation id</DisplayName>
        <Description>Caller correlation id. Empty means none. Echoed on the response.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>TimeoutSeconds</Identifier>
        <DisplayName>Timeout (seconds)</DisplayName>
        <Description>Command timeout in seconds. 0 means the server default.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Payload</Identifier>
        <DisplayName>Payload</DisplayName>
        <Description>UTF-8 JSON string for the request body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>Envelope</Identifier>
  <DisplayName>Envelope</DisplayName>
  <Description>Standard command result. Outcome is Succeeded, Failed, Rejected, or Running. Code is 0 on Succeeded and empty on Running. Message defaults to success on Succeeded. Empty Details means none.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Version</Identifier>
        <DisplayName>Version</DisplayName>
        <Description>Envelope schema version. Currently 2.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Outcome</Identifier>
        <DisplayName>Outcome</DisplayName>
        <Description>Succeeded, Failed, Rejected, or Running.</Description>
        <DataType>
          <Constrained>
            <DataType>
              <Basic>String</Basic>
            </DataType>
            <Constraints>
              <Set>
                <Value>Succeeded</Value>
                <Value>Failed</Value>
                <Value>Rejected</Value>
                <Value>Running</Value>
              </Set>
            </Constraints>
          </Constrained>
        </DataType>
      </Element>
      <Element>
        <Identifier>Code</Identifier>
        <DisplayName>Code</DisplayName>
        <Description>Additive lowercase dotted code on Failed/Rejected. 0 on Succeeded. Empty on Running.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Message</Identifier>
        <DisplayName>Message</DisplayName>
        <Description>Human-readable outcome message. Defaults to success on Succeeded.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>CorrelationId</Identifier>
        <DisplayName>Correlation id</DisplayName>
        <Description>Echo of the request correlation id. Empty means none.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Payload</Identifier>
        <DisplayName>Payload</DisplayName>
        <Description>UTF-8 JSON string for the result body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Details</Identifier>
        <DisplayName>Details</DisplayName>
        <Description>UTF-8 JSON string for diagnostics such as status_code, url, and canForce. Empty string means none.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>InstrumentStatusProgress</Identifier>
  <DisplayName>Instrument status progress</DisplayName>
  <Description>Intermediate Update Payload during WaitUntilIdle / WaitForTestStarted.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>WaitUntilIdleResult</Identifier>
  <DisplayName>Wait until idle result</DisplayName>
  <Description>WaitUntilIdle Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>WaitForTestStartedResult</Identifier>
  <DisplayName>Wait for test started result</DisplayName>
  <Description>WaitForTestStarted Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>GetInstrumentErrorsResult</Identifier>
  <DisplayName>Get instrument errors result</DisplayName>
  <Description>GetInstrumentErrors Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>GetControlPanelSignalsResult</Identifier>
  <DisplayName>Get control panel signals result</DisplayName>
  <Description>GetControlPanelSignals Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Body</Identifier>
        <DisplayName>Body</DisplayName>
        <Description>Opaque TRIOS REST JSON response (or status snapshot).</Description>
        <DataType><Basic>Any</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<Property>
  <Identifier>CurrentInstrumentStatus</Identifier>
  <DisplayName>Instrument status</DisplayName>
  <Description>GET /status body as UTF-8 JSON. Subscribeable; Get returns a live snapshot.</Description>
  <Observable>Yes</Observable>
  <DataType><Basic>String</Basic></DataType>
</Property>
<Command>
  <Identifier>WaitUntilIdle</Identifier>
  <DisplayName>Wait until idle</DisplayName>
  <Description>POST /status/wait-idle while streaming GET /status as Update envelopes. Request.TimeoutSeconds is forwarded to TRIOS (0 = server default). Update Payload is InstrumentStatusProgress; Result.Payload is WaitUntilIdleResult.</Description>
  <Observable>Yes</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <IntermediateResponse>
    <Identifier>Update</Identifier>
    <DisplayName>Update</DisplayName>
    <Description>Intermediate envelope with Outcome Running.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </IntermediateResponse>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<Command>
  <Identifier>WaitForTestStarted</Identifier>
  <DisplayName>Wait until test starts</DisplayName>
  <Description>POST /status/wait-test-started while streaming GET /status as Update envelopes. Request.TimeoutSeconds is forwarded to TRIOS (0 = server default). Update Payload is InstrumentStatusProgress; Result.Payload is WaitForTestStartedResult.</Description>
  <Observable>Yes</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <IntermediateResponse>
    <Identifier>Update</Identifier>
    <DisplayName>Update</DisplayName>
    <Description>Intermediate envelope with Outcome Running.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </IntermediateResponse>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<Command>
  <Identifier>GetInstrumentErrors</Identifier>
  <DisplayName>List instrument errors</DisplayName>
  <Description>GET /errors. Result.Payload is GetInstrumentErrorsResult.</Description>
  <Observable>No</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<Command>
  <Identifier>GetControlPanelSignals</Identifier>
  <DisplayName>Control panel signals</DisplayName>
  <Description>GET /signals. Result.Payload is GetControlPanelSignalsResult.</Description>
  <Observable>No</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<DefinedExecutionError>
  <Identifier>InternalError</Identifier>
  <DisplayName>Internal error</DisplayName>
  <Description>The server could not build an envelope (connection drop, unexpected exception, or cancellation).</Description>
</DefinedExecutionError>
</Feature>
