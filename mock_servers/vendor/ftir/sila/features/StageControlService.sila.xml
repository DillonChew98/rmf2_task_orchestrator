<Feature xmlns="http://www.sila-standard.org" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Category="ftir" FeatureVersion="2.0" MaturityLevel="Draft" Originator="com.bruker" SiLA2Version="1.0" xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
<Identifier>StageControlService</Identifier>
<DisplayName>FTIR stage control</DisplayName>
<Description>Control of the sample stage / plate transport (e.g. HTS-XT): absolute moves, well addressing, load/unload, reference positions, and stage discovery.</Description>
<DataTypeDefinition>
  <Identifier>Request</Identifier>
  <DisplayName>Request</DisplayName>
  <Description>Standard command request. Version is the envelope schema version. Empty CorrelationId means none. TimeoutSeconds 0 means the server default. Empty Payload means none.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Version</Identifier>
        <DisplayName>Version</DisplayName>
        <Description>Envelope schema version. Currently 2.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>CorrelationId</Identifier>
        <DisplayName>Correlation id</DisplayName>
        <Description>Caller correlation id. Empty means none. Echoed on the response.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>TimeoutSeconds</Identifier>
        <DisplayName>Timeout (seconds)</DisplayName>
        <Description>Command timeout in seconds. 0 means the server default.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Payload</Identifier>
        <DisplayName>Payload</DisplayName>
        <Description>UTF-8 JSON string for the request body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>Envelope</Identifier>
  <DisplayName>Envelope</DisplayName>
  <Description>Standard command result. Outcome is Succeeded, Failed, Rejected, or Running. Code is 0 on Succeeded and empty on Running. Message defaults to success on Succeeded. Empty Details means none.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Version</Identifier>
        <DisplayName>Version</DisplayName>
        <Description>Envelope schema version. Currently 2.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Outcome</Identifier>
        <DisplayName>Outcome</DisplayName>
        <Description>Succeeded, Failed, Rejected, or Running.</Description>
        <DataType>
          <Constrained>
            <DataType>
              <Basic>String</Basic>
            </DataType>
            <Constraints>
              <Set>
                <Value>Succeeded</Value>
                <Value>Failed</Value>
                <Value>Rejected</Value>
                <Value>Running</Value>
              </Set>
            </Constraints>
          </Constrained>
        </DataType>
      </Element>
      <Element>
        <Identifier>Code</Identifier>
        <DisplayName>Code</DisplayName>
        <Description>Additive lowercase dotted code on Failed/Rejected. 0 on Succeeded. Empty on Running.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Message</Identifier>
        <DisplayName>Message</DisplayName>
        <Description>Human-readable outcome message. Defaults to success on Succeeded.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>CorrelationId</Identifier>
        <DisplayName>Correlation id</DisplayName>
        <Description>Echo of the request correlation id. Empty means none.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Payload</Identifier>
        <DisplayName>Payload</DisplayName>
        <Description>UTF-8 JSON string for the result body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Details</Identifier>
        <DisplayName>Details</DisplayName>
        <Description>UTF-8 JSON string for diagnostics such as status_code, url, and canForce. Empty string means none.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>DrawerResult</Identifier>
  <DisplayName>Drawer / stage result</DisplayName>
  <Description>Stage and drawer command Result.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Function</Identifier>
        <DisplayName>Function</DisplayName>
        <Description>OPUS / binding function name that was invoked.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Response</Identifier>
        <DisplayName>Response</DisplayName>
        <Description>Raw OPUS response lines.</Description>
        <DataType><List><DataType><Basic>String</Basic></DataType></List></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>DrawerProgress</Identifier>
  <DisplayName>Drawer progress</DisplayName>
  <Description>Intermediate Update Payload during OpenDrawer / CloseDrawer.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Phase</Identifier>
        <DisplayName>Phase</DisplayName>
        <Description>Drawer move phase, e.g. running.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>MoveStageRequestPayload</Identifier>
  <DisplayName>Move stage request payload</DisplayName>
  <Description>MoveStage Request.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Device</Identifier>
        <DisplayName>Device</DisplayName>
        <Description>Stage device id; empty means OPUS default.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>X</Identifier>
        <DisplayName>X</DisplayName>
        <Description>Absolute X coordinate.</Description>
        <DataType><Basic>Real</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Y</Identifier>
        <DisplayName>Y</DisplayName>
        <Description>Absolute Y coordinate.</Description>
        <DataType><Basic>Real</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>MoveToWellRequestPayload</Identifier>
  <DisplayName>Move to well request payload</DisplayName>
  <Description>MoveToWell Request.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Well</Identifier>
        <DisplayName>Well</DisplayName>
        <Description>Well label, e.g. A1, B3, H12.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>PlateFormat</Identifier>
        <DisplayName>Plate format</DisplayName>
        <Description>Plate well count (96 or 24); 0 means hts_xt.json default.</Description>
        <DataType><Basic>Integer</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>MoveStageToReferencePositionRequestPayload</Identifier>
  <DisplayName>Move stage to reference request payload</DisplayName>
  <Description>MoveStageToReferencePosition Request.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Device</Identifier>
        <DisplayName>Device</DisplayName>
        <Description>Stage device id; empty means OPUS default.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>ReferencePosition</Identifier>
        <DisplayName>Reference position</DisplayName>
        <Description>Named reference position.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>DeviceRequestPayload</Identifier>
  <DisplayName>Device request payload</DisplayName>
  <Description>Request.Payload with optional Device for stage queries.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Device</Identifier>
        <DisplayName>Device</DisplayName>
        <Description>Stage device id; empty means OPUS default.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>GetStageNameRequestPayload</Identifier>
  <DisplayName>Get stage name request payload</DisplayName>
  <Description>GetStageName Request.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>ImagingDevice</Identifier>
        <DisplayName>Imaging device</DisplayName>
        <Description>Imaging device id; empty means OPUS default.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<DataTypeDefinition>
  <Identifier>SetReferencePositionRequestPayload</Identifier>
  <DisplayName>Set reference position request payload</DisplayName>
  <Description>SetReferencePosition Request.Payload.</Description>
  <DataType>
    <Structure>
      <Element>
        <Identifier>Device</Identifier>
        <DisplayName>Device</DisplayName>
        <Description>Stage device id; empty means OPUS default.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>ReferencePosition</Identifier>
        <DisplayName>Reference position</DisplayName>
        <Description>Named reference position to define.</Description>
        <DataType><Basic>String</Basic></DataType>
      </Element>
      <Element>
        <Identifier>X</Identifier>
        <DisplayName>X</DisplayName>
        <Description>Absolute X coordinate.</Description>
        <DataType><Basic>Real</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Y</Identifier>
        <DisplayName>Y</DisplayName>
        <Description>Absolute Y coordinate.</Description>
        <DataType><Basic>Real</Basic></DataType>
      </Element>
      <Element>
        <Identifier>Z</Identifier>
        <DisplayName>Z</DisplayName>
        <Description>Absolute Z coordinate.</Description>
        <DataType><Basic>Real</Basic></DataType>
      </Element>
    </Structure>
  </DataType>
</DataTypeDefinition>
<Command>
  <Identifier>MoveStage</Identifier>
  <DisplayName>Move stage</DisplayName>
  <Description>Move the stage / plate transport to absolute coordinates via OPUS MoveStage. Request.Payload is MoveStageRequestPayload; Result.Payload is DrawerResult.</Description>
  <Observable>No</Observable>
  <Parameter>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request.</Description>
    <DataType><DataTypeIdentifier>Request</DataTypeIdentifier></DataType>
  </Parameter>
  <Response>
    <Identifier>Result</Identifier>
    <DisplayName>Result</DisplayName>
    <Description>Standard command envelope.</Description>
    <DataType><DataTypeIdentifier>Envelope</DataTypeIdentifier></DataType>
  </Response>
  <DefinedExecutionErrors><Identifier>InternalError</Identifier></DefinedExecutionErrors>
</Command>
<Command>
  <Identifier>MoveToWell</Identifier>
  <DisplayName>Move to well</DisplayName>
