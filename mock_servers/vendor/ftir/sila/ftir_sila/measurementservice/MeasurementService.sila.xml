  <Command>
    <Identifier>MeasureBackground</Identifier>
    <DisplayName>Measure background</DisplayName>
    <Description>Acquire a background (reference) spectrum via OPUS MeasureReference. Request.Payload is MeasureBackgroundRequestPayload. Streams Update envelopes (MeasureProgress) during the OPUS thread; Request.TimeoutSeconds sets lifetime_of_execution when non-zero.</Description>
    <Observable>Yes</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <IntermediateResponse>
      <Identifier>Update</Identifier>
      <DisplayName>Update</DisplayName>
      <Description>Intermediate envelope with Outcome Running.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </IntermediateResponse>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>MeasureSample</Identifier>
    <DisplayName>Measure sample</DisplayName>
    <Description>Run OPUS MeasureSample. Request.Payload is MeasureSampleRequestPayload. Result.Payload is MeasureSampleResult. OPUS soft-fail becomes Envelope Failed with opus.measurement.failed. Streams Update envelopes (MeasureProgress) during the OPUS thread.</Description>
    <Observable>Yes</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <IntermediateResponse>
      <Identifier>Update</Identifier>
      <DisplayName>Update</DisplayName>
      <Description>Intermediate envelope with Outcome Running.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </IntermediateResponse>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
