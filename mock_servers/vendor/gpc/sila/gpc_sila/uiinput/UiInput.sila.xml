<Feature xmlns="http://www.sila-standard.org" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Category="gpc" FeatureVersion="2.0" MaturityLevel="Draft" Originator="org.tainstruments" SiLA2Version="1.0" xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>UiInput</Identifier>
  <DisplayName>WinGPC raw UI input</DisplayName>
  <Description>Low-level UI automation primitives for menu navigation, mouse, keyboard, locator-based control interaction, window waits, and tree exploration. All commands require the state machine to be in Maintenance.</Description>
  <DataTypeDefinition>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request. Version is the envelope schema version. Empty CorrelationId means none. TimeoutSeconds 0 means the server default. Empty Payload means none.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Version</Identifier>
          <DisplayName>Version</DisplayName>
          <Description>Envelope schema version. Currently 2.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>CorrelationId</Identifier>
          <DisplayName>Correlation id</DisplayName>
          <Description>Caller correlation id. Empty means none. Echoed on the response.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>TimeoutSeconds</Identifier>
          <DisplayName>Timeout (seconds)</DisplayName>
          <Description>Command timeout in seconds. 0 means the server default.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Payload</Identifier>
          <DisplayName>Payload</DisplayName>
          <Description>UTF-8 JSON string for the request body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
  <DataTypeDefinition>
    <Identifier>Envelope</Identifier>
    <DisplayName>Envelope</DisplayName>
    <Description>Standard command result. Outcome is Succeeded, Failed, Rejected, or Running. Code is 0 on Succeeded and empty on Running. Message defaults to success on Succeeded. Empty Details means none.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Version</Identifier>
          <DisplayName>Version</DisplayName>
          <Description>Envelope schema version. Currently 2.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Outcome</Identifier>
          <DisplayName>Outcome</DisplayName>
          <Description>Succeeded, Failed, Rejected, or Running.</Description>
          <DataType>
            <Constrained>
              <DataType>
                <Basic>String</Basic>
              </DataType>
              <Constraints>
                <Set>
                  <Value>Succeeded</Value>
                  <Value>Failed</Value>
                  <Value>Rejected</Value>
                  <Value>Running</Value>
                </Set>
              </Constraints>
            </Constrained>
          </DataType>
        </Element>
        <Element>
          <Identifier>Code</Identifier>
          <DisplayName>Code</DisplayName>
          <Description>Additive lowercase dotted code on Failed/Rejected. 0 on Succeeded. Empty on Running.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Message</Identifier>
          <DisplayName>Message</DisplayName>
          <Description>Human-readable outcome message. Defaults to success on Succeeded.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>CorrelationId</Identifier>
          <DisplayName>Correlation id</DisplayName>
          <Description>Echo of the request correlation id. Empty means none.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Payload</Identifier>
          <DisplayName>Payload</DisplayName>
          <Description>UTF-8 JSON string for the result body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Details</Identifier>
          <DisplayName>Details</DisplayName>
          <Description>UTF-8 JSON string for diagnostics such as status_code, url, and canForce. Empty string means none.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
  <Command>
    <Identifier>ClickMenu</Identifier>
    <DisplayName>Click menu path</DisplayName>
    <Description>Navigate the Application menu bar by item names. Payload must include MenuPath (list of strings), e.g. ["File", "Open"].</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>ClickAt</Identifier>
    <DisplayName>Click at coordinates</DisplayName>
    <Description>Click at absolute screen coordinates via pyautogui. Payload must include X and Y; optional Clicks (default 1).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>TypeText</Identifier>
    <DisplayName>Type text</DisplayName>
    <Description>Type text via pyautogui at the current focus. Payload must include Text; optional IntervalMs (0 = default 20 ms).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Hotkey</Identifier>
    <DisplayName>Send hotkey</DisplayName>
    <Description>Send a hotkey combo via pyautogui. Payload must include Keys (non-empty list of strings), e.g. ["ctrl", "s"].</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>FindControl</Identifier>
    <DisplayName>Find control by locator</DisplayName>
    <Description>Locate a UIA control under the main window by any combination of title, AutomationId, or control type. Payload must include Locator (object with optional title, auto_id, control_type). Result Payload is a descriptor object (does not return a handle).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>ClickControlByLocator</Identifier>
    <DisplayName>Click control by locator</DisplayName>
    <Description>Find a control by locator and click it. Payload must include Locator (object with optional title, auto_id, control_type).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>TypeIntoControlByLocator</Identifier>
    <DisplayName>Type into control by locator</DisplayName>
    <Description>Find a control by locator, focus it, optionally clear, and type. Payload must include Locator and Text; optional ClearFirst (boolean).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>WaitForWindow</Identifier>
    <DisplayName>Wait for window</DisplayName>
    <Description>Wait for a top-level window with the given title to appear. Payload must include Title. Request.TimeoutSeconds is the wait budget (0 = GPC client default).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>WaitUntilGone</Identifier>
    <DisplayName>Wait until window gone</DisplayName>
    <Description>Wait until a top-level window with the given title disappears. Payload must include Title. Request.TimeoutSeconds is the wait budget (0 = GPC client default of 10s).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>PrintControlTree</Identifier>
    <DisplayName>Print control tree</DisplayName>
    <Description>Print the UIA control tree to the server log. Payload may include Depth (0 = default 3).</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>ListChildren</Identifier>
    <DisplayName>List children</DisplayName>
    <Description>List immediate children of a UIA control with their key properties. Payload may include Locator (object; omit or empty for the main window). Result Payload is a list of child descriptor objects.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <DefinedExecutionError>
    <Identifier>InternalError</Identifier>
    <DisplayName>Internal error</DisplayName>
    <Description>The server could not build an envelope (connection drop, unexpected exception, or cancellation).</Description>
  </DefinedExecutionError>
</Feature>
