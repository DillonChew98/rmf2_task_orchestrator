<Feature xmlns="http://www.sila-standard.org" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Category="gpc" FeatureVersion="2.0" MaturityLevel="Draft" Originator="org.tainstruments" SiLA2Version="1.0" xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>InstrumentLifecycle</Identifier>
  <DisplayName>WinGPC instrument lifecycle</DisplayName>
  <Description>Owns the GPC server state chart (Disconnected, Connect, Run, Pause, Maintenance) and exposes lifecycle commands. The CurrentState property is observable so clients can subscribe to state changes.</Description>
  <DataTypeDefinition>
    <Identifier>Request</Identifier>
    <DisplayName>Request</DisplayName>
    <Description>Standard command request. Version is the envelope schema version. Empty CorrelationId means none. TimeoutSeconds 0 means the server default. Empty Payload means none.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Version</Identifier>
          <DisplayName>Version</DisplayName>
          <Description>Envelope schema version. Currently 2.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>CorrelationId</Identifier>
          <DisplayName>Correlation id</DisplayName>
          <Description>Caller correlation id. Empty means none. Echoed on the response.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>TimeoutSeconds</Identifier>
          <DisplayName>Timeout (seconds)</DisplayName>
          <Description>Command timeout in seconds. 0 means the server default.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Payload</Identifier>
          <DisplayName>Payload</DisplayName>
          <Description>UTF-8 JSON string for the request body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
  <DataTypeDefinition>
    <Identifier>Envelope</Identifier>
    <DisplayName>Envelope</DisplayName>
    <Description>Standard command result. Outcome is Succeeded, Failed, Rejected, or Running. Code is 0 on Succeeded and empty on Running. Message defaults to success on Succeeded. Empty Details means none.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Version</Identifier>
          <DisplayName>Version</DisplayName>
          <Description>Envelope schema version. Currently 2.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Outcome</Identifier>
          <DisplayName>Outcome</DisplayName>
          <Description>Succeeded, Failed, Rejected, or Running.</Description>
          <DataType>
            <Constrained>
              <DataType>
                <Basic>String</Basic>
              </DataType>
              <Constraints>
                <Set>
                  <Value>Succeeded</Value>
                  <Value>Failed</Value>
                  <Value>Rejected</Value>
                  <Value>Running</Value>
                </Set>
              </Constraints>
            </Constrained>
          </DataType>
        </Element>
        <Element>
          <Identifier>Code</Identifier>
          <DisplayName>Code</DisplayName>
          <Description>Additive lowercase dotted code on Failed/Rejected. 0 on Succeeded. Empty on Running.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Message</Identifier>
          <DisplayName>Message</DisplayName>
          <Description>Human-readable outcome message. Defaults to success on Succeeded.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>CorrelationId</Identifier>
          <DisplayName>Correlation id</DisplayName>
          <Description>Echo of the request correlation id. Empty means none.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Payload</Identifier>
          <DisplayName>Payload</DisplayName>
          <Description>UTF-8 JSON string for the result body. Empty string means none. Prefer a JSON object matching the command DataTypeDefinition.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Details</Identifier>
          <DisplayName>Details</DisplayName>
          <Description>UTF-8 JSON string for diagnostics such as status_code, url, and canForce. Empty string means none.</Description>
          <DataType>
            <Basic>String</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
  <Property>
    <Identifier>CurrentState</Identifier>
    <DisplayName>Current state</DisplayName>
    <Description>Current state of the GPC server state machine. One of: Disconnected, Connect, Run, Pause, Maintenance.</Description>
    <Observable>Yes</Observable>
    <DataType>
      <Basic>String</Basic>
    </DataType>
  </Property>
  <Command>
    <Identifier>Connect</Identifier>
    <DisplayName>Connect</DisplayName>
    <Description>Attach to the running Agilent WinGPC instance via UIA. Allowed only from Disconnected. Transitions to Connect on success. Result Payload includes state.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Disconnect</Identifier>
    <DisplayName>Disconnect</DisplayName>
    <Description>Drop the cached UIA references and return to Disconnected. Allowed from Connect. Result Payload includes state.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>BringToFront</Identifier>
    <DisplayName>Bring window to front</DisplayName>
    <Description>Bring the WinGPC main window to the foreground. Allowed in any connected state.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>EnterMaintenance</Identifier>
    <DisplayName>Enter maintenance mode</DisplayName>
    <Description>Transition Connect -&gt; Maintenance to allow raw UI input commands (UiInput feature). Result Payload includes state.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>ExitMaintenance</Identifier>
    <DisplayName>Exit maintenance mode</DisplayName>
    <Description>Transition Maintenance -&gt; Connect. Result Payload includes state.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Pause</Identifier>
    <DisplayName>Pause</DisplayName>
    <Description>Logical pause: transition Run -&gt; Pause. WinGPC has no native pause control; this is a state-machine-only operation. Result Payload includes state.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Resume</Identifier>
    <DisplayName>Resume</DisplayName>
    <Description>Transition Pause -&gt; Run. Result Payload includes state.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>Stop</Identifier>
    <DisplayName>Stop</DisplayName>
    <Description>Stop the running sequence: if currently in Run/Pause and the Start toggle is ON, click it once to toggle OFF. Always transitions back to Connect on success. Result Payload includes state and clicked_start.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Request</Identifier>
      <DisplayName>Request</DisplayName>
      <Description>Standard command request.</Description>
      <DataType>
        <DataTypeIdentifier>Request</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Result</Identifier>
      <DisplayName>Result</DisplayName>
      <Description>Standard command envelope.</Description>
      <DataType>
        <DataTypeIdentifier>Envelope</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>InternalError</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <DefinedExecutionError>
    <Identifier>InternalError</Identifier>
    <DisplayName>Internal error</DisplayName>
    <Description>The server could not build an envelope (connection drop, unexpected exception, or cancellation).</Description>
  </DefinedExecutionError>
</Feature>
