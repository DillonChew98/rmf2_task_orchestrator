{
  "version": "0.1.0",
  "description": "Get GPC status",
  "start": "get_status",
  "ops": {
    "get_status": {
      "type": "node",
      "builder": "grpc_request",
      "display_text": "Get GPC status",
      "config": {
        "service": "sila2.org.tainstruments.gpc.instrumentstatus.v2.InstrumentStatus",
        "method": "GetInstrumentSnapshot",
        "uri": "${lab.gpc_host}",
        "timeout": 120,
        "request": {
          "Request": {
            "Request": {
              "Version": {
                "value": 2
              },
              "CorrelationId": {
                "value": "marvel-gpc-status"
              },
              "TimeoutSeconds": {
                "value": 0
              },
              "Payload": {
                "value": ""
              }
            }
          }
        }
      },
      "stream_out": {
        "out": "check_outcome"
      },
      "next": "if_call_ok"
    },
    "if_call_ok": {
      "type": "fork_result",
      "ok": {
        "builtin": "dispose"
      },
      "err": "report_start_failed"
    },
    "check_outcome": {
      "type": "node",
      "builder": "cel_condition",
      "display_text": "Did the server say Succeeded?",
      "config": {
        "condition": "Result.Envelope.Outcome.value == 'Succeeded'"
      },
      "next": "if_succeeded"
    },
    "if_succeeded": {
      "type": "fork_result",
      "ok": "report_succeeded",
      "err": "report_outcome_failed"
    },
    "report_succeeded": {
      "type": "transform",
      "cel": "{'result': 'succeeded', 'status': request.Result.Envelope.Payload.value}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_start_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'get_status', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_outcome_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'check_outcome', 'detail': request.error, 'last_reply': request.message}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    }
  }
}