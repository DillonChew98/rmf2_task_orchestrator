{
  "version": "0.1.0",
  "description": "Load X3 DSC sample pan",
  "start": "load_sample_pan",
  "ops": {
    "load_sample_pan": {
      "type": "node",
      "builder": "grpc_request",
      "display_text": "Load sample pan",
      "config": {
        "service": "sila2.org.tainstruments.xdsc.autosamplercontrol.v2.AutosamplerControl",
        "method": "LoadSamplePan",
        "uri": "${lab.dsc_host}",
        "timeout": 20,
        "request": {
          "Request": {
            "Request": {
              "Version": {
                "value": 2
              },
              "CorrelationId": {
                "value": "marvel-load-sample-pan-call"
              },
              "TimeoutSeconds": {
                "value": 0
              },
              "Payload": {
                "value": ""
              }
            }
          }
        }
      },
      "stream_out": {
        "out": "take_uuid"
      },
      "next": "if_requested"
    },
    "if_requested": {
      "type": "fork_result",
      "ok": {
        "builtin": "dispose"
      },
      "err": "report_start_failed"
    },
    "take_uuid": {
      "type": "transform",
      "display_text": "Pull the command UUID out of the confirmation",
      "cel": "{'value': request.commandExecutionUUID.value}",
      "next": "fan_uuid",
      "on_error": {
        "builtin": "dispose"
      }
    },
    "fan_uuid": {
      "type": "fork_clone",
      "next": [
        "saved_uuid",
        "watch_progress"
      ]
    },
    "saved_uuid": {
      "type": "buffer"
    },
    "watch_progress": {
      "type": "node",
      "builder": "grpc_request",
      "display_text": "Follow progress",
      "config": {
        "service": "sila2.org.tainstruments.xdsc.autosamplercontrol.v2.AutosamplerControl",
        "method": "LoadSamplePan_Info",
        "uri": "${lab.dsc_host}",
        "timeout": 120
      },
      "stream_out": {
        "out": {
          "builtin": "dispose"
        }
      },
      "next": "if_finished"
    },
    "if_finished": {
      "type": "fork_result",
      "ok": "finished_tick",
      "err": "report_watch_failed"
    },
    "finished_tick": {
      "type": "buffer"
    },
    "result_gate": {
      "type": "join",
      "buffers": {
        "uuid": "saved_uuid",
        "tick": "finished_tick"
      },
      "next": "build_result_request"
    },
    "build_result_request": {
      "type": "transform",
      "display_text": "Rebuild the uuid request from the saved uuid",
      "cel": "{'value': request.uuid.value}",
      "next": "read_result",
      "on_error": {
        "builtin": "dispose"
      }
    },
    "read_result": {
      "type": "node",
      "builder": "grpc_request",
      "display_text": "LoadSamplePan_Result: wait for the command to finish, get the envelope",
      "config": {
        "service": "sila2.org.tainstruments.xdsc.autosamplercontrol.v2.AutosamplerControl",
        "method": "LoadSamplePan_Result",
        "uri": "${lab.dsc_host}",
        "timeout": 20
      },
      "stream_out": {
        "out": "check_outcome"
      },
      "next": "if_result_read"
    },
    "if_result_read": {
      "type": "fork_result",
      "ok": {
        "builtin": "dispose"
      },
      "err": "report_result_read_failed"
    },
    "check_outcome": {
      "type": "node",
      "builder": "cel_condition",
      "display_text": "Did the server say Succeeded?",
      "config": {
        "condition": "Result.Envelope.Outcome.value == 'Succeeded'"
      },
      "next": "if_succeeded"
    },
    "if_succeeded": {
      "type": "fork_result",
      "ok": "report_succeeded",
      "err": "report_outcome_failed"
    },
    "report_succeeded": {
      "type": "transform",
      "cel": "{'result': 'succeeded', 'reply': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_start_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'load_sample_pan', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_watch_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'watch_progress', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_result_read_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'read_result', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_outcome_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'check_outcome', 'detail': request.error, 'last_reply': request.message}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    }
  }
}
