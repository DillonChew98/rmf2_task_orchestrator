{
  "version": "0.1.0",
  "description": "Add X3 DSC experiment from experiment server",
  "start": "fetch_experiment",
  "ops": {
    "fetch_experiment": {
      "type": "node",
      "builder": "http_request",
      "display_text": "GET the experiment from the experiment server",
      "config": {
        "method": "GET",
        "uri": "${lab.experiment_server_host}/api/experiments/EXP-009"
      },
      "next": "if_fetched"
    },
    "if_fetched": {
      "type": "fork_result",
      "ok": "build_request",
      "err": "report_fetch_failed"
    },
    "build_request": {
      "type": "transform",
      "cel": "{'Request': {'Request': {'Version': {'value': 2}, 'CorrelationId': {'value': ''}, 'TimeoutSeconds': {'value': 0}, 'Payload': {'QueueType': 'running', 'Body': {'newExperiments': [request.runs[0].run_method]}}}}}",
      "next": "add_experiment"
    },
    "add_experiment": {
      "type": "node",
      "builder": "grpc_request",
      "display_text": "AddNewExperiments: put the fetched experiment in the running queue",
      "stream_out": {
        "out": "check_outcome"
      },
      "next": "if_call_ok",
      "config": {
        "service": "sila2.org.tainstruments.xdsc.queuemanagement.v2.QueueManagement",
        "method": "AddNewExperiments",
        "uri": "${lab.dsc_host}",
        "timeout": 90
      }
    },
    "if_call_ok": {
      "type": "fork_result",
      "ok": {
        "builtin": "dispose"
      },
      "err": "report_start_failed"
    },
    "check_outcome": {
      "type": "node",
      "builder": "cel_condition",
      "display_text": "Did the server say Succeeded?",
      "config": {
        "condition": "Result.Envelope.Outcome.value == 'Succeeded'"
      },
      "next": "if_succeeded"
    },
    "if_succeeded": {
      "type": "fork_result",
      "ok": "report_succeeded",
      "err": "report_outcome_failed"
    },
    "report_succeeded": {
      "type": "transform",
      "cel": "{'result': 'succeeded', 'reply': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_start_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'add_experiment', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_outcome_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'check_outcome', 'detail': request.error, 'last_reply': request.message}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_fetch_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'fetch_experiment', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    }
  }
}