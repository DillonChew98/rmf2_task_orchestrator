{
  "version": "0.1.0",
  "description": "Export X3 DSC results",
  "start": "export_results",
  "ops": {
    "export_results": {
      "type": "node",
      "builder": "grpc_request",
      "display_text": "Export results as JSON",
      "config": {
        "service": "sila2.org.tainstruments.xdsc.resultsexport.v2.ResultsExport",
        "method": "ExportResultsJson",
        "uri": "${lab.dsc_host}",
        "request": {
          "Request": {
            "Request": {
              "Version": {
                "value": 2
              },
              "CorrelationId": {
                "value": "marvel-dsc-export-results"
              },
              "TimeoutSeconds": {
                "value": 0
              },
              "Payload": {
                "value": "{\"path\": \"C:/Users/User/Desktop/experiment_output\", \"async\": false}"
              }
            }
          }
        }
      },
      "stream_out": {
        "out": "check_outcome"
      },
      "next": "if_call_ok"
    },
    "if_call_ok": {
      "type": "fork_result",
      "ok": {
        "builtin": "dispose"
      },
      "err": "report_start_failed"
    },
    "check_outcome": {
      "type": "node",
      "builder": "cel_condition",
      "display_text": "Did the server say Succeeded?",
      "config": {
        "condition": "Result.Envelope.Outcome.value == 'Succeeded'"
      },
      "next": "if_succeeded"
    },
    "if_succeeded": {
      "type": "fork_result",
      "ok": "report_succeeded",
      "err": "report_outcome_failed"
    },
    "report_succeeded": {
      "type": "transform",
      "cel": "{'result': 'succeeded', 'reply': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_start_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'export_results', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_outcome_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'check_outcome', 'detail': request.error, 'last_reply': request.message}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    }
  }
}
