{
  "version": "0.1.0",
  "description": "Add SDT experiment",
  "start": "add_experiment",
  "ops": {
    "add_experiment": {
      "type": "node",
      "builder": "grpc_request",
      "display_text": "Add New Experiment",
      "config": {
        "service": "sila2.org.tainstruments.sdt.queuemanagement.v2.QueueManagement",
        "method": "AddNewExperiments",
        "uri": "${lab.tga_host}",
        "timeout": 90,
        "request": {
          "Request": {
            "Request": {
              "Version": {
                "value": 2
              },
              "CorrelationId": {
                "value": "marvel-sdt-add-experiment"
              },
              "TimeoutSeconds": {
                "value": 0
              },
              "Payload": {
                "value": "{\"QueueType\":\"running\",\"Body\":{\"newExperiments\":[{\"experimentKind\":\"dualSample\",\"name\":\"empty_combustion_air\",\"sampleInfo\":{\"sampleAName\":\"sampleA\",\"sampleAPan\":{\"trayPosition\":29,\"panType\":\"Aluminum\"},\"sampleBName\":\"sampleB\",\"sampleBPan\":{\"trayPosition\":30,\"panType\":\"Aluminum\"},\"operator\":\"robot\",\"project\":\"marvel\",\"notes\":\"robot testing only\"},\"filePaths\":{\"fileDirectory\":\"C:\\\\Users\\\\User\\\\Desktop\\\\experiment_output\",\"tokens\":\"TGA-<SAMPLENAME>\"},\"procedure\":{\"testType\":\"Custom\",\"procedureName\":\"demo_test\",\"segments\":[{\"type\":\"Ramp\",\"rampRateDegCPerMin\":10,\"finalTemperatureC\":500},{\"type\":\"Isothermal\",\"isothermTimeMin\":5}],\"advancedOptions\":{\"skipWeightStabilization\":true,\"airCoolEnable\":true,\"coolUntilTemperatureC\":25,\"endOfRunDelayMin\":0}}}]}}"
              }
            }
          }
        }
      },
      "stream_out": {
        "out": "check_outcome"
      },
      "next": "if_call_ok"
    },
    "if_call_ok": {
      "type": "fork_result",
      "ok": {
        "builtin": "dispose"
      },
      "err": "report_start_failed"
    },
    "check_outcome": {
      "type": "node",
      "builder": "cel_condition",
      "display_text": "Did the server say Succeeded?",
      "config": {
        "condition": "Result.Envelope.Outcome.value == 'Succeeded'"
      },
      "next": "if_succeeded"
    },
    "if_succeeded": {
      "type": "fork_result",
      "ok": "report_succeeded",
      "err": "report_outcome_failed"
    },
    "report_succeeded": {
      "type": "transform",
      "cel": "{'result': 'succeeded', 'reply': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_start_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'add_experiment', 'detail': request}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    },
    "report_outcome_failed": {
      "type": "transform",
      "cel": "{'result': 'failed', 'step': 'check_outcome', 'detail': request.error, 'last_reply': request.message}",
      "next": {
        "builtin": "terminate"
      },
      "on_error": {
        "builtin": "dispose"
      }
    }
  }
}
