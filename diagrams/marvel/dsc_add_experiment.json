{
  "templates": {
    "dsc_add_experiment": {
      "inputs": [
        "start"
      ],
      "outputs": [
        "ok",
        "failed"
      ],
      "ops": {
        "start": {
          "type": "scope",
          "start": "build_request",
          "ops": {
            "build_request": {
              "type": "transform",
              "display_text": "Build request from experiment",
              "cel": "{'Request': {'Request': {'Version': {'value': 2}, 'CorrelationId': {'value': 'marvel-dsc-add-experiment'}, 'TimeoutSeconds': {'value': 0}, 'Payload': {'value': '{\"QueueType\": \"running\", \"Body\": {\"newExperiments\": [' + request.runs[0].run_method_str + ']}}'}}}}",
              "next": "add_experiment",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "add_experiment": {
              "type": "node",
              "builder": "grpc_request",
              "display_text": "Add New Experiment (plain JSON payload)",
              "config": {
                "service": "sila2.org.tainstruments.xdsc.queuemanagement.v2.QueueManagement",
                "method": "AddNewExperiments",
                "uri": "${lab.dsc_host}",
                "timeout": 45
              },
              "stream_out": {
                "out": "check_outcome"
              },
              "next": "if_call_ok"
            },
            "if_call_ok": {
              "type": "fork_result",
              "ok": {
                "builtin": "dispose"
              },
              "err": "report_start_failed"
            },
            "check_outcome": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Did the server say Succeeded?",
              "config": {
                "condition": "Result.Envelope.Outcome.value == 'Succeeded'"
              },
              "next": "if_succeeded"
            },
            "if_succeeded": {
              "type": "fork_result",
              "ok": "report_succeeded",
              "err": "report_outcome_failed"
            },
            "report_succeeded": {
              "type": "transform",
              "cel": "{'result': 'succeeded', 'reply': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_start_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'add_experiment', 'detail': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_outcome_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'check_outcome', 'detail': request.error, 'last_reply': request.message}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            }
          },
          "next": "is_success"
        },
        "is_success": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did the box succeed? The command reported Succeeded",
          "config": {
            "condition": "result == 'succeeded'"
          },
          "next": "if_success"
        },
        "if_success": {
          "type": "fork_result",
          "ok": "ok",
          "err": "failed"
        }
      }
    }
  }
}
