{
  "templates": {
    "storage_start_unloading": {
      "inputs": {
        "start": "check_input"
      },
      "outputs": [
        "precedence",
        "resource"
      ],
      "buffers": [
        "status_report"
      ],
      "ops": {
        "check_input": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did every result in the input end ok?",
          "config": {
            "condition": "has(message.status) ? message.status == 'ok' : message.all(k, message[k].status == 'ok')"
          },
          "next": "if_input_ok"
        },
        "if_input_ok": {
          "type": "fork_result",
          "ok": {
            "request": "start"
          },
          "err": "status_skipped"
        },
        "request": {
          "type": "section",
          "template": "storage_send_unload_request",
          "connect": {
            "ok": {
              "wait_ready": "start"
            },
            "failed": "status_failed"
          },
          "op_sequence": 1
        },
        "wait_ready": {
          "type": "section",
          "template": "storage_wait_ready_to_unload",
          "connect": {
            "ok": {
              "set_busy": "start"
            },
            "failed": "status_failed"
          },
          "op_sequence": 2
        },
        "set_busy": {
          "type": "section",
          "template": "storage_set_unload_busy",
          "connect": {
            "ok": "status_ok",
            "failed": "status_failed"
          },
          "op_sequence": 3
        },
        "status_ok": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_failed": {
          "type": "transform",
          "cel": "{'status': 'failed', 'detail': request}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_skipped": {
          "type": "transform",
          "cel": "{'status': 'skipped', 'because': request.error}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "copy_status": {
          "type": "fork_clone",
          "next": [
            "to_precedence",
            "to_resource",
            "status_report"
          ]
        },
        "to_precedence": {
          "type": "transform",
          "cel": "request",
          "next": "precedence",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "to_resource": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "resource",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_report": {
          "type": "buffer"
        }
      }
    }
  }
}
