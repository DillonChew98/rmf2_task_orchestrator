{
  "templates": {
    "ftir_process": {
      "inputs": {
        "start": "check_input"
      },
      "outputs": [
        "precedence",
        "resource"
      ],
      "buffers": [
        "status_report"
      ],
      "ops": {
        "check_input": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did every result in the input end ok?",
          "config": {
            "condition": "has(message.status) ? message.status == 'ok' : message.all(k, message[k].status == 'ok')"
          },
          "next": "if_input_ok"
        },
        "if_input_ok": {
          "type": "fork_result",
          "ok": {
            "background": "start"
          },
          "err": "status_skipped"
        },
        "background": {
          "type": "section",
          "template": "ftir_measure_background",
          "connect": {
            "ok": "fetch_experiment",
            "failed": "status_failed"
          },
          "op_sequence": 1
        },
        "fetch_experiment": {
          "type": "node",
          "builder": "http_request",
          "display_text": "Get experiment",
          "config": {
            "method": "GET",
            "uri": "${lab.experiment_server_host}/api/experiments/${section.experiment_id}"
          },
          "next": "if_fetched"
        },
        "if_fetched": {
          "type": "fork_result",
          "ok": {
            "measure": "start"
          },
          "err": "status_failed"
        },
        "measure": {
          "type": "section",
          "template": "ftir_measure_sample",
          "connect": {
            "ok": "status_ok",
            "failed": "status_failed"
          },
          "op_sequence": 2
        },
        "status_ok": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_failed": {
          "type": "transform",
          "cel": "{'status': 'failed', 'detail': request}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_skipped": {
          "type": "transform",
          "cel": "{'status': 'skipped', 'because': request.error}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "copy_status": {
          "type": "fork_clone",
          "next": [
            "to_precedence",
            "to_resource",
            "status_report"
          ]
        },
        "to_precedence": {
          "type": "transform",
          "cel": "request",
          "next": "precedence",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "to_resource": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "resource",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_report": {
          "type": "buffer"
        }
      }
    }
  }
}
