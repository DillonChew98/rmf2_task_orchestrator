{
  "templates": {
    "dsc_add_experiment_with_fixed_payload": {
      "inputs": [
        "start"
      ],
      "outputs": [
        "ok",
        "failed"
      ],
      "ops": {
        "start": {
          "type": "scope",
          "start": "add_experiment",
          "ops": {
            "add_experiment": {
              "type": "node",
              "builder": "grpc_request",
              "display_text": "Add New Experiment (plain JSON payload)",
              "config": {
                "service": "sila2.org.tainstruments.xdsc.queuemanagement.v2.QueueManagement",
                "method": "AddNewExperiments",
                "uri": "${lab.dsc_host}",
                "timeout": 45,
                "request": {
                  "Request": {
                    "Request": {
                      "Version": {
                        "value": 2
                      },
                      "CorrelationId": {
                        "value": "marvel-dsc-add-experiment"
                      },
                      "TimeoutSeconds": {
                        "value": 0
                      },
                      "Payload": {
                        "value": "{\"QueueType\": \"running\", \"Body\": {\"newExperiments\": [{\"sampleInfo\": {\"sampleNameA\": \"nameA\", \"sampleNameB\": \"nameB\", \"sampleNameC\": \"nameC\", \"samplePanA\": {\"trayPosition\": 12, \"sampleMass\": 5, \"panMass\": 42.7, \"panType\": \"TzeroAlum\"}, \"samplePanB\": {\"trayPosition\": 13, \"sampleMass\": 4.8, \"panMass\": 43.5, \"panType\": \"TzeroAlum\"}, \"samplePanC\": {\"trayPosition\": 14, \"sampleMass\": 5.1, \"panMass\": 43.7, \"panType\": \"TzeroAlum\"}, \"useSensorA\": true, \"useSensorB\": true, \"useSensorC\": true, \"referencePan\": {\"trayPosition\": 15, \"panType\": \"None\", \"referenceMass\": 54, \"panMass\": 0}, \"operator\": \"robot\", \"project\": \"marvel\", \"notes\": \"demo robot only\"}, \"filePaths\": {\"fileDirectory\": \"C:\\\\Users\\\\User\\\\Desktop\\\\experiment_output\", \"tokens\": \"DSC-<SAMPLENAME>\"}, \"procedure\": {\"procedureName\": \"demo experiment\", \"testType\": \"StandardCustom\", \"segments\": [{\"type\": \"Data\", \"dataOn\": true}, {\"type\": \"Equilibrate\", \"temperatureC\": -60}, {\"type\": \"Isothermal\", \"isothermTimeMin\": 5, \"temperatureC\": 0}, {\"type\": \"Ramp\", \"rampRateDegCPerMin\": 10, \"finalTemperatureC\": 190}, {\"type\": \"Isothermal\", \"isothermTimeMin\": 5, \"temperatureC\": 0}]}}]}}"
                      }
                    }
                  }
                }
              },
              "stream_out": {
                "out": "check_outcome"
              },
              "next": "if_call_ok"
            },
            "if_call_ok": {
              "type": "fork_result",
              "ok": {
                "builtin": "dispose"
              },
              "err": "report_start_failed"
            },
            "check_outcome": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Did the server say Succeeded?",
              "config": {
                "condition": "Result.Envelope.Outcome.value == 'Succeeded'"
              },
              "next": "if_succeeded"
            },
            "if_succeeded": {
              "type": "fork_result",
              "ok": "report_succeeded",
              "err": "report_outcome_failed"
            },
            "report_succeeded": {
              "type": "transform",
              "cel": "{'result': 'succeeded', 'reply': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_start_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'add_experiment', 'detail': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_outcome_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'check_outcome', 'detail': request.error, 'last_reply': request.message}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            }
          },
          "next": "is_success"
        },
        "is_success": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did the box succeed? The command reported Succeeded",
          "config": {
            "condition": "result == 'succeeded'"
          },
          "next": "if_success"
        },
        "if_success": {
          "type": "fork_result",
          "ok": "ok",
          "err": "failed"
        }
      }
    }
  }
}
