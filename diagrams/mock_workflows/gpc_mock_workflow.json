{
  "version": "0.1.0",
  "description": "Full GPC workflow with the 5 s mock process. Generated by scripts/gen_mock_workflows.py. Do not hand-edit.",
  "templates": {
    "mir_move_to_waypoint": {
      "inputs": [
        "start"
      ],
      "outputs": [
        "ok",
        "failed"
      ],
      "ops": {
        "start": {
          "type": "scope",
          "start": "fork_target_and_status",
          "ops": {
            "fork_target_and_status": {
              "type": "fork_clone",
              "next": [
                "saved_waypoint",
                "target_tick",
                "read_robot_status"
              ]
            },
            "saved_waypoint": {
              "type": "buffer"
            },
            "target_tick": {
              "type": "buffer",
              "serialize": true
            },
            "target_gate": {
              "type": "join",
              "buffers": {
                "waypoint": "saved_waypoint",
                "tick": "target_tick"
              },
              "clone": [
                "waypoint"
              ],
              "serialize": true,
              "next": "build_target_request"
            },
            "build_target_request": {
              "type": "transform",
              "cel": "{'uri': '${lab.mir_host}/api/v2.0.0/positions/' + request.waypoint.waypoint}",
              "on_error": {
                "builtin": "dispose"
              },
              "next": "fetch_target_position"
            },
            "fetch_target_position": {
              "type": "node",
              "builder": "http_request",
              "display_text": "GET /positions/{guid}: fetch the target position",
              "config": {
                "method": "GET",
                "headers": {
                  "Accept": "application/json",
                  "Authorization": "${MIR_AUTH}",
                  "Accept-Language": "en_US"
                },
                "retry": {}
              },
              "next": "if_target_fetched"
            },
            "if_target_fetched": {
              "type": "fork_result",
              "ok": "saved_target",
              "err": "report_setup_failed"
            },
            "saved_target": {
              "type": "buffer"
            },
            "read_robot_status": {
              "type": "node",
              "builder": "http_request",
              "display_text": "GET /status: read the robot status",
              "config": {
                "method": "GET",
                "uri": "${lab.mir_host}/api/v2.0.0/status",
                "headers": {
                  "Accept": "application/json",
                  "Authorization": "${MIR_AUTH}",
                  "Accept-Language": "en_US"
                },
                "retry": {}
              },
              "next": "if_status_read"
            },
            "if_status_read": {
              "type": "fork_result",
              "ok": "keep_state_fields",
              "err": "report_setup_failed"
            },
            "keep_state_fields": {
              "type": "transform",
              "cel": "{'state_id': request.state_id, 'state_text': request.state_text, 'mission_queue_id': request.mission_queue_id, 'mission_text': request.mission_text, 'position': request.position}",
              "next": "is_robot_free",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "is_robot_free": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Is the robot free? Ready, or parked on the charger",
              "config": {
                "condition": "state_id == 3 || (state_id == 5 && mission_text.contains('Waiting for new mission'))"
              },
              "next": "if_robot_free"
            },
            "if_robot_free": {
              "type": "fork_result",
              "ok": "saved_free_status",
              "err": "wait_then_recheck_free"
            },
            "wait_then_recheck_free": {
              "type": "node",
              "builder": "timeout",
              "display_text": "Wait 5 s, then check again. Give up after 25 s",
              "config": {
                "interval_secs": 5,
                "timeout_secs": 25
              },
              "next": "if_free_retries_left"
            },
            "if_free_retries_left": {
              "type": "fork_result",
              "ok": "read_robot_status",
              "err": "report_robot_busy"
            },
            "report_robot_busy": {
              "type": "transform",
              "next": {
                "builtin": "terminate"
              },
              "cel": "{'result': 'failed', 'phase': 'setup', 'kind': 'robot busy', 'detail': request.message}",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_setup_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'phase': 'setup', 'kind': 'http call failed', 'detail': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "saved_free_status": {
              "type": "buffer"
            },
            "pair_target_with_status": {
              "type": "join",
              "buffers": {
                "target": "saved_target",
                "robot": "saved_free_status"
              },
              "clone": [
                "target"
              ],
              "serialize": true,
              "next": "is_robot_away_from_target"
            },
            "is_robot_away_from_target": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Is the robot more than 0.3 m from the target?",
              "config": {
                "condition": "(robot.position.x - target.pos_x) * (robot.position.x - target.pos_x) + (robot.position.y - target.pos_y) * (robot.position.y - target.pos_y) > 0.09"
              },
              "next": "if_robot_away"
            },
            "if_robot_away": {
              "type": "fork_result",
              "ok": "read_arm_safety",
              "err": "report_already_at_target"
            },
            "read_arm_safety": {
              "type": "node",
              "builder": "http_request",
              "display_text": "Read arm status",
              "config": {
                "method": "GET",
                "uri": "${lab.ur_host}/task/status",
                "headers": {
                  "Accept": "application/json"
                },
                "retry": {}
              },
              "next": "if_arm_read"
            },
            "if_arm_read": {
              "type": "fork_result",
              "ok": "is_mir_safe_to_move",
              "err": "report_setup_failed"
            },
            "is_mir_safe_to_move": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Safe to drive?",
              "config": {
                "condition": "mir_safe_to_move == true"
              },
              "next": "if_mir_safe"
            },
            "if_mir_safe": {
              "type": "fork_result",
              "ok": "move_tick",
              "err": "wait_then_recheck_arm"
            },
            "wait_then_recheck_arm": {
              "type": "node",
              "builder": "timeout",
              "display_text": "Wait for the arm",
              "config": {
                "interval_secs": 5,
                "timeout_secs": 30
              },
              "next": "if_arm_retries_left"
            },
            "if_arm_retries_left": {
              "type": "fork_result",
              "ok": "read_arm_safety",
              "err": "report_arm_not_safe"
            },
            "report_arm_not_safe": {
              "type": "transform",
              "cel": "{'result': 'failed', 'phase': 'setup', 'kind': 'arm not safe', 'detail': request.message}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "move_tick": {
              "type": "buffer",
              "serialize": true
            },
            "move_gate": {
              "type": "join",
              "buffers": {
                "target": "saved_target",
                "tick": "move_tick"
              },
              "clone": [
                "target"
              ],
              "serialize": true,
              "next": "build_move_request"
            },
            "report_already_at_target": {
              "type": "transform",
              "cel": "{'result': 'already at destination', 'target': request.message.target.name, 'position': request.message.robot.position}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "build_move_request": {
              "type": "transform",
              "cel": "{'mission_id': 'mirconst-guid-0000-0001-actionlist00', 'parameters': [{'input_name': 'Position', 'value': request.target.guid}]}",
              "next": "send_move",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "send_move": {
              "type": "node",
              "builder": "http_request",
              "display_text": "POST /mission_queue: send the Move",
              "config": {
                "method": "POST",
                "uri": "${lab.mir_host}/api/v2.0.0/mission_queue",
                "headers": {
                  "Accept": "application/json",
                  "Authorization": "${MIR_AUTH}",
                  "Accept-Language": "en_US"
                },
                "retry": {}
              },
              "next": "if_move_sent"
            },
            "if_move_sent": {
              "type": "fork_result",
              "ok": "remember_mission",
              "err": "why_http_call_failed"
            },
            "remember_mission": {
              "type": "transform",
              "cel": "{'uri': '${lab.mir_host}/api/v2.0.0/mission_queue/' + string(request.id), 'queue_id': request.id}",
              "next": "start_polling",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "start_polling": {
              "type": "fork_clone",
              "next": [
                "saved_mission",
                "poll_tick"
              ]
            },
            "saved_mission": {
              "type": "buffer"
            },
            "poll_tick": {
              "type": "buffer",
              "serialize": true
            },
            "poll_gate": {
              "type": "join",
              "buffers": {
                "mission": "saved_mission",
                "tick": "poll_tick"
              },
              "clone": [
                "mission"
              ],
              "serialize": true,
              "next": "build_poll_request"
            },
            "build_poll_request": {
              "type": "transform",
              "cel": "{'uri': request.mission.uri}",
              "next": "read_mission_state",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "read_mission_state": {
              "type": "node",
              "builder": "http_request",
              "display_text": "GET /mission_queue/{id}: how is our own mission doing?",
              "config": {
                "method": "GET",
                "headers": {
                  "Accept": "application/json",
                  "Authorization": "${MIR_AUTH}",
                  "Accept-Language": "en_US"
                },
                "retry": {}
              },
              "next": "if_mission_read"
            },
            "if_mission_read": {
              "type": "fork_result",
              "ok": "is_mission_finished",
              "err": "why_http_call_failed"
            },
            "is_mission_finished": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Has the mission ended? Done, Abort or Aborted",
              "config": {
                "condition": "state == 'Done' || state == 'Abort' || state == 'Aborted'"
              },
              "next": "if_mission_finished"
            },
            "if_mission_finished": {
              "type": "fork_result",
              "ok": "is_mission_done",
              "err": "wait_then_poll_again"
            },
            "is_mission_done": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Did it end well? Done, not Aborted",
              "config": {
                "condition": "state == 'Done'"
              },
              "next": "if_mission_done"
            },
            "if_mission_done": {
              "type": "fork_result",
              "ok": "arrived_tick",
              "err": "why_mission_aborted"
            },
            "wait_then_poll_again": {
              "type": "node",
              "builder": "timeout",
              "display_text": "Still Pending or Executing. Wait 5 s, then poll again. Give up after 2 min",
              "config": {
                "interval_secs": 5,
                "timeout_secs": 120
              },
              "next": "if_poll_retries_left"
            },
            "if_poll_retries_left": {
              "type": "fork_result",
              "ok": "poll_tick",
              "err": "why_mission_timed_out"
            },
            "arrived_tick": {
              "type": "buffer",
              "serialize": true
            },
            "arrived_gate": {
              "type": "join",
              "buffers": {
                "target": "saved_target",
                "tick": "arrived_tick"
              },
              "clone": [
                "target"
              ],
              "serialize": true,
              "next": "report_final_status"
            },
            "report_final_status": {
              "type": "transform",
              "cel": "{'result': 'arrived', 'location': request.target.name, 'queue_id': request.tick.id}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "why_mission_aborted": {
              "type": "transform",
              "cel": "{'kind': 'mission aborted', 'detail': request.message}",
              "next": "fan_move_failure",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "fan_move_failure": {
              "type": "fork_clone",
              "next": [
                "saved_move_failure",
                "clear_mission_queue"
              ]
            },
            "saved_move_failure": {
              "type": "buffer"
            },
            "charge_tick": {
              "type": "buffer"
            },
            "move_failure_gate": {
              "type": "join",
              "buffers": {
                "failure": "saved_move_failure",
                "tick": "charge_tick"
              },
              "serialize": true,
              "next": "report_move_failed"
            },
            "clear_mission_queue": {
              "type": "node",
              "builder": "http_request",
              "display_text": "DELETE /mission_queue: wipe the queue, aborting the Move",
              "config": {
                "method": "DELETE",
                "uri": "${lab.mir_host}/api/v2.0.0/mission_queue",
                "headers": {
                  "Accept": "application/json",
                  "Authorization": "${MIR_AUTH}",
                  "Accept-Language": "en_US"
                },
                "retry": {}
              },
              "next": "if_queue_cleared"
            },
            "if_queue_cleared": {
              "type": "fork_result",
              "ok": "send_to_charger",
              "err": "report_queue_clear_failed"
            },
            "send_to_charger": {
              "type": "node",
              "builder": "http_request",
              "display_text": "POST /mission_queue: ChargeAtStation, send the robot home",
              "config": {
                "method": "POST",
                "uri": "${lab.mir_host}/api/v2.0.0/mission_queue",
                "headers": {
                  "Accept": "application/json",
                  "Authorization": "${MIR_AUTH}",
                  "Accept-Language": "en_US"
                },
                "body": {
                  "mission_id": "mirconst-guid-0000-0004-actionlist00",
                  "parameters": [
                    {
                      "input_name": "chargingStationPosition",
                      "value": "${lab.charger_waypoint}"
                    },
                    {
                      "input_name": "numberOfRetries",
                      "value": 4
                    }
                  ]
                }
              },
              "next": "if_charge_sent"
            },
            "if_charge_sent": {
              "type": "fork_result",
              "ok": "charge_tick",
              "err": "report_charge_failed"
            },
            "report_move_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'phase': 'move', 'kind': request.failure.kind, 'detail': request.failure.detail, 'note': 'robot sent to the charger'}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_queue_clear_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'phase': 'recovery', 'kind': 'http call failed', 'step': 'clear mission queue', 'detail': request, 'note': 'the queue may still hold the Move, so the robot may still be driving'}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_charge_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'phase': 'recovery', 'kind': 'http call failed', 'step': 'send to charger', 'detail': request, 'note': 'the queue is wiped, so the robot has stopped'}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "why_http_call_failed": {
              "type": "transform",
              "next": "fan_move_failure",
              "cel": "{'kind': 'http call failed', 'detail': request}",
              "on_error": {
                "builtin": "dispose"
              }
            },
            "why_mission_timed_out": {
              "type": "transform",
              "cel": "{'kind': 'mission timed out', 'detail': request.message}",
              "next": "fan_move_failure",
              "on_error": {
                "builtin": "dispose"
              }
            }
          },
          "next": "is_success"
        },
        "is_success": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did the box succeed? Arrived, or already at the destination",
          "config": {
            "condition": "result == 'arrived' || result == 'already at destination'"
          },
          "next": "if_success"
        },
        "if_success": {
          "type": "fork_result",
          "ok": "ok",
          "err": "failed"
        }
      }
    },
    "mock_gpc_process": {
      "inputs": {
        "start": "check_input"
      },
      "outputs": [
        "precedence",
        "resource"
      ],
      "buffers": [
        "status_report"
      ],
      "ops": {
        "check_input": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did every result in the input end ok?",
          "config": {
            "condition": "has(message.status) ? message.status == 'ok' : message.all(k, message[k].status == 'ok')"
          },
          "next": "if_input_ok"
        },
        "if_input_ok": {
          "type": "fork_result",
          "ok": "wait",
          "err": "status_skipped"
        },
        "wait": {
          "type": "node",
          "builder": "timeout",
          "config": {
            "interval_secs": 5,
            "timeout_secs": 300
          },
          "next": "wait_result"
        },
        "wait_result": {
          "type": "fork_result",
          "ok": "status_ok",
          "err": "status_failed"
        },
        "status_ok": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_failed": {
          "type": "transform",
          "cel": "{'status': 'failed', 'detail': request}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_skipped": {
          "type": "transform",
          "cel": "{'status': 'skipped', 'because': request.error}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "copy_status": {
          "type": "fork_clone",
          "next": [
            "to_precedence",
            "to_resource",
            "status_report"
          ]
        },
        "to_precedence": {
          "type": "transform",
          "cel": "request",
          "next": "precedence",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "to_resource": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "resource",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_report": {
          "type": "buffer"
        }
      }
    },
    "pick_gpc_vials_from_gpc": {
      "inputs": {
        "start": "check_input"
      },
      "outputs": [
        "precedence",
        "resource"
      ],
      "buffers": [
        "status_report"
      ],
      "ops": {
        "check_input": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did every result in the input end ok?",
          "config": {
            "condition": "has(message.status) ? message.status == 'ok' : message.all(k, message[k].status == 'ok')"
          },
          "next": "if_input_ok"
        },
        "if_input_ok": {
          "type": "fork_result",
          "ok": "set_waypoint",
          "err": "status_skipped"
        },
        "set_waypoint": {
          "type": "transform",
          "cel": "{'waypoint': '${lab.gpc_waypoint}'}",
          "next": {
            "move": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "move": {
          "type": "section",
          "template": "mir_move_to_waypoint",
          "connect": {
            "ok": "set_task",
            "failed": "status_failed"
          }
        },
        "set_task": {
          "type": "transform",
          "cel": "{'task': 'gpc', 'action': 'pick', 'item': ''}",
          "next": {
            "pick": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "pick": {
          "type": "section",
          "template": "ur_perform_task",
          "connect": {
            "ok": "status_ok",
            "failed": "status_failed"
          }
        },
        "status_ok": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_failed": {
          "type": "transform",
          "cel": "{'status': 'failed', 'detail': request}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_skipped": {
          "type": "transform",
          "cel": "{'status': 'skipped', 'because': request.error}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "copy_status": {
          "type": "fork_clone",
          "next": [
            "to_precedence",
            "to_resource",
            "status_report"
          ]
        },
        "to_precedence": {
          "type": "transform",
          "cel": "request",
          "next": "precedence",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "to_resource": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "resource",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_report": {
          "type": "buffer"
        }
      }
    },
    "pick_gpc_vials_from_spm": {
      "inputs": {
        "start": "check_input"
      },
      "outputs": [
        "precedence",
        "resource"
      ],
      "buffers": [
        "status_report"
      ],
      "ops": {
        "check_input": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did every result in the input end ok?",
          "config": {
            "condition": "has(message.status) ? message.status == 'ok' : message.all(k, message[k].status == 'ok')"
          },
          "next": "if_input_ok"
        },
        "if_input_ok": {
          "type": "fork_result",
          "ok": "set_waypoint",
          "err": "status_skipped"
        },
        "set_waypoint": {
          "type": "transform",
          "cel": "{'waypoint': '${lab.spm_waypoint}'}",
          "next": {
            "move": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "move": {
          "type": "section",
          "template": "mir_move_to_waypoint",
          "connect": {
            "ok": "set_task",
            "failed": "status_failed"
          }
        },
        "set_task": {
          "type": "transform",
          "cel": "{'task': 'bench', 'action': 'pick', 'item': 'GPC'}",
          "next": {
            "pick": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "pick": {
          "type": "section",
          "template": "ur_perform_task",
          "connect": {
            "ok": "status_ok",
            "failed": "status_failed"
          }
        },
        "status_ok": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_failed": {
          "type": "transform",
          "cel": "{'status': 'failed', 'detail': request}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_skipped": {
          "type": "transform",
          "cel": "{'status': 'skipped', 'because': request.error}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "copy_status": {
          "type": "fork_clone",
          "next": [
            "to_precedence",
            "to_resource",
            "status_report"
          ]
        },
        "to_precedence": {
          "type": "transform",
          "cel": "request",
          "next": "precedence",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "to_resource": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "resource",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_report": {
          "type": "buffer"
        }
      }
    },
    "place_gpc_vials_at_gpc": {
      "inputs": {
        "start": "check_input"
      },
      "outputs": [
        "precedence",
        "resource"
      ],
      "buffers": [
        "status_report"
      ],
      "ops": {
        "check_input": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did every result in the input end ok?",
          "config": {
            "condition": "has(message.status) ? message.status == 'ok' : message.all(k, message[k].status == 'ok')"
          },
          "next": "if_input_ok"
        },
        "if_input_ok": {
          "type": "fork_result",
          "ok": "set_waypoint",
          "err": "status_skipped"
        },
        "set_waypoint": {
          "type": "transform",
          "cel": "{'waypoint': '${lab.gpc_waypoint}'}",
          "next": {
            "move": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "move": {
          "type": "section",
          "template": "mir_move_to_waypoint",
          "connect": {
            "ok": "set_task",
            "failed": "status_failed"
          }
        },
        "set_task": {
          "type": "transform",
          "cel": "{'task': 'gpc', 'action': 'place', 'item': ''}",
          "next": {
            "place": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "place": {
          "type": "section",
          "template": "ur_perform_task",
          "connect": {
            "ok": "status_ok",
            "failed": "status_failed"
          }
        },
        "status_ok": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_failed": {
          "type": "transform",
          "cel": "{'status': 'failed', 'detail': request}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_skipped": {
          "type": "transform",
          "cel": "{'status': 'skipped', 'because': request.error}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "copy_status": {
          "type": "fork_clone",
          "next": [
            "to_precedence",
            "to_resource",
            "status_report"
          ]
        },
        "to_precedence": {
          "type": "transform",
          "cel": "request",
          "next": "precedence",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "to_resource": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "resource",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_report": {
          "type": "buffer"
        }
      }
    },
    "place_gpc_vials_on_workbench": {
      "inputs": {
        "start": "check_input"
      },
      "outputs": [
        "precedence",
        "resource"
      ],
      "buffers": [
        "status_report"
      ],
      "ops": {
        "check_input": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did every result in the input end ok?",
          "config": {
            "condition": "has(message.status) ? message.status == 'ok' : message.all(k, message[k].status == 'ok')"
          },
          "next": "if_input_ok"
        },
        "if_input_ok": {
          "type": "fork_result",
          "ok": "set_waypoint",
          "err": "status_skipped"
        },
        "set_waypoint": {
          "type": "transform",
          "cel": "{'waypoint': '${lab.spm_waypoint}'}",
          "next": {
            "move": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "move": {
          "type": "section",
          "template": "mir_move_to_waypoint",
          "connect": {
            "ok": "set_task",
            "failed": "status_failed"
          }
        },
        "set_task": {
          "type": "transform",
          "cel": "{'task': 'bench', 'action': 'place', 'item': 'GPC'}",
          "next": {
            "place": "start"
          },
          "on_error": {
            "builtin": "dispose"
          }
        },
        "place": {
          "type": "section",
          "template": "ur_perform_task",
          "connect": {
            "ok": "status_ok",
            "failed": "status_failed"
          }
        },
        "status_ok": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_failed": {
          "type": "transform",
          "cel": "{'status': 'failed', 'detail': request}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_skipped": {
          "type": "transform",
          "cel": "{'status': 'skipped', 'because': request.error}",
          "next": "copy_status",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "copy_status": {
          "type": "fork_clone",
          "next": [
            "to_precedence",
            "to_resource",
            "status_report"
          ]
        },
        "to_precedence": {
          "type": "transform",
          "cel": "request",
          "next": "precedence",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "to_resource": {
          "type": "transform",
          "cel": "{'status': 'ok'}",
          "next": "resource",
          "on_error": {
            "builtin": "dispose"
          }
        },
        "status_report": {
          "type": "buffer"
        }
      }
    },
    "ur_perform_task": {
      "inputs": [
        "start"
      ],
      "outputs": [
        "ok",
        "failed"
      ],
      "ops": {
        "start": {
          "type": "scope",
          "start": "fork_params_and_start",
          "ops": {
            "fork_params_and_start": {
              "type": "fork_clone",
              "next": [
                "saved_params",
                "read_arm_status"
              ]
            },
            "saved_params": {
              "type": "buffer"
            },
            "read_arm_status": {
              "type": "node",
              "builder": "http_request",
              "display_text": "GET /task/status: is the arm free?",
              "config": {
                "method": "GET",
                "uri": "${lab.ur_host}/task/status",
                "headers": {
                  "Accept": "application/json"
                },
                "retry": {}
              },
              "next": "if_arm_status_read"
            },
            "if_arm_status_read": {
              "type": "fork_result",
              "ok": "is_arm_ready",
              "err": "report_arm_status_read_failed"
            },
            "is_arm_ready": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Arm ready? Nothing running and External Control up",
              "config": {
                "condition": "ready == true"
              },
              "next": "if_arm_ready"
            },
            "if_arm_ready": {
              "type": "fork_result",
              "ok": "start_tick",
              "err": "wait_then_recheck_arm"
            },
            "wait_then_recheck_arm": {
              "type": "node",
              "builder": "timeout",
              "display_text": "Arm busy. Wait 5 s, give up after 30 s",
              "config": {
                "interval_secs": 5,
                "timeout_secs": 30
              },
              "next": "if_arm_wait_left"
            },
            "if_arm_wait_left": {
              "type": "fork_result",
              "ok": "read_arm_status",
              "err": "report_arm_not_ready"
            },
            "report_arm_not_ready": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'wait_for_arm', 'detail': request.error, 'last_reply': request.message}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_arm_status_read_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'read_arm_status', 'detail': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "start_tick": {
              "type": "buffer",
              "serialize": true
            },
            "start_gate": {
              "type": "join",
              "buffers": {
                "params": "saved_params",
                "tick": "start_tick"
              },
              "clone": [
                "params"
              ],
              "serialize": true,
              "next": "build_start_body"
            },
            "build_start_body": {
              "type": "transform",
              "cel": "{'task': request.params.task, 'action': request.params.action, 'item': request.params.item}",
              "on_error": {
                "builtin": "dispose"
              },
              "next": "start_task"
            },
            "start_task": {
              "type": "node",
              "builder": "http_request",
              "display_text": "POST /task/start: run the task from the message body",
              "config": {
                "method": "POST",
                "uri": "${lab.ur_host}/task/start",
                "headers": {
                  "Accept": "application/json"
                },
                "retry": {}
              },
              "next": "if_task_started"
            },
            "if_task_started": {
              "type": "fork_result",
              "ok": "status_tick",
              "err": "report_start_refused"
            },
            "report_start_refused": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'start_task', 'detail': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "status_tick": {
              "type": "buffer",
              "serialize": true
            },
            "status_gate": {
              "type": "join",
              "buffers": {
                "params": "saved_params",
                "tick": "status_tick"
              },
              "clone": [
                "params"
              ],
              "serialize": true,
              "next": "build_status_uri"
            },
            "build_status_uri": {
              "type": "transform",
              "cel": "{'uri': '${lab.ur_host}/task/status?task=' + request.params.task}",
              "on_error": {
                "builtin": "dispose"
              },
              "next": "read_task_status"
            },
            "read_task_status": {
              "type": "node",
              "builder": "http_request",
              "display_text": "GET /task/status?task=<task>: has it ended?",
              "config": {
                "method": "GET",
                "headers": {
                  "Accept": "application/json"
                },
                "retry": {}
              },
              "next": "if_task_status_read"
            },
            "if_task_status_read": {
              "type": "fork_result",
              "ok": "has_task_ended",
              "err": "report_task_read_failed"
            },
            "report_task_read_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'read_task_status', 'detail': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "has_task_ended": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Task ended? COMPLETED or ERROR",
              "config": {
                "condition": "state == 'COMPLETED' || state == 'ERROR'"
              },
              "next": "if_task_ended"
            },
            "if_task_ended": {
              "type": "fork_result",
              "ok": "did_task_succeed",
              "err": "wait_then_poll_task"
            },
            "wait_then_poll_task": {
              "type": "node",
              "builder": "timeout",
              "display_text": "Still running. Wait 5 s, give up after 120 s",
              "config": {
                "interval_secs": 5,
                "timeout_secs": 120
              },
              "next": "if_task_wait_left"
            },
            "if_task_wait_left": {
              "type": "fork_result",
              "ok": "status_tick",
              "err": "report_task_timed_out"
            },
            "report_task_timed_out": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'wait_for_task', 'detail': request.error, 'last_reply': request.message}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "did_task_succeed": {
              "type": "node",
              "builder": "cel_condition",
              "display_text": "Ended well? COMPLETED, not ERROR",
              "config": {
                "condition": "state == 'COMPLETED'"
              },
              "next": "if_task_succeeded"
            },
            "if_task_succeeded": {
              "type": "fork_result",
              "ok": "report_task_done",
              "err": "report_task_failed"
            },
            "report_task_done": {
              "type": "transform",
              "cel": "{'result': 'done', 'status': request}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            },
            "report_task_failed": {
              "type": "transform",
              "cel": "{'result': 'failed', 'step': 'run_task', 'detail': request.message}",
              "next": {
                "builtin": "terminate"
              },
              "on_error": {
                "builtin": "dispose"
              }
            }
          },
          "next": "is_success"
        },
        "is_success": {
          "type": "node",
          "builder": "cel_condition",
          "display_text": "Did the box succeed? Task done",
          "config": {
            "condition": "result == 'done'"
          },
          "next": "if_success"
        },
        "if_success": {
          "type": "fork_result",
          "ok": "ok",
          "err": "failed"
        }
      }
    }
  },
  "start": "run_started",
  "ops": {
    "pick_from_spm": {
      "type": "section",
      "template": "pick_gpc_vials_from_spm",
      "connect": {
        "precedence": {
          "place_on_gpc": "start"
        }
      },
      "workflow_id": "gpc"
    },
    "place_on_gpc": {
      "type": "section",
      "template": "place_gpc_vials_at_gpc",
      "connect": {
        "precedence": {
          "process": "start"
        }
      },
      "workflow_id": "gpc"
    },
    "process": {
      "type": "section",
      "template": "mock_gpc_process",
      "connect": {
        "precedence": {
          "pick_from_gpc": "start"
        }
      },
      "workflow_id": "gpc"
    },
    "pick_from_gpc": {
      "type": "section",
      "template": "pick_gpc_vials_from_gpc",
      "connect": {
        "precedence": {
          "place_on_workbench": "start"
        }
      },
      "workflow_id": "gpc"
    },
    "place_on_workbench": {
      "type": "section",
      "template": "place_gpc_vials_on_workbench",
      "connect": {},
      "workflow_id": "gpc"
    },
    "join__end": {
      "type": "join",
      "buffers": {
        "pick_from_spm": {
          "pick_from_spm": "status_report"
        },
        "place_on_gpc": {
          "place_on_gpc": "status_report"
        },
        "process": {
          "process": "status_report"
        },
        "pick_from_gpc": {
          "pick_from_gpc": "status_report"
        },
        "place_on_workbench": {
          "place_on_workbench": "status_report"
        }
      },
      "next": {
        "builtin": "terminate"
      }
    },
    "run_started": {
      "type": "transform",
      "cel": "{'status': 'ok'}",
      "next": {
        "pick_from_spm": "start"
      },
      "on_error": {
        "builtin": "dispose"
      }
    }
  }
}
